{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "penpot-local": {
      "type": "streamable-http",
      "url": "http://${PENPOT_LOCAL_HOST:-penpot.localhost}/mcp/stream?userToken=${PENPOT_LOCAL_KEY}"
    },
    "penpot-remote": {
      "type": "streamable-http",
      "url": "https://${PENPOT_REMOTE_DOMAIN:-design.penpot.app}/mcp/stream?userToken=${PENPOT_REMOTE_KEY}"
    }
  }
}
